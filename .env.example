VITE_SUPABASE_PROJECT_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_APP_ENVIRONMENT=development
VITE_ENABLE_ANALYTICS=false
# VITE_ALLOWED_EMAIL_DOMAINS=example.com,corp.com
# Leave empty to use smart pattern matching (allows business emails, blocks disposable domains)
VITE_ALLOWED_EMAIL_DOMAINS=
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY # used only in tests or scripts, never ship to client

# Demo mode (optional). Shows one-click demo login buttons and a demo banner.
# VITE_DEMO_MODE=true
# VITE_DEMO_MANAGER_EMAIL=demo-manager@example.com
# VITE_DEMO_EMPLOYEE_EMAIL=demo-employee@example.com
# VITE_DEMO_PASSWORD=
